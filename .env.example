# Master Database
DB_MASTER_HOST=localhost
DB_MASTER_DATABASE=pontoao_master
DB_MASTER_USERNAME=root
DB_MASTER_PASSWORD=

# Tenant Config
DB_TENANT_PREFIX=tenant_

# API Security
JWT_SECRET=sua_chave_secreta_aqui
JWT_EXPIRATION=28800

# App Environment
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000

# Super Admin
SUPER_ADMIN_PASSWORD=change_this_in_production

# Dahua Auto Upload webhook authentication
DAHUA_WEBHOOK_USER=pontoao
DAHUA_WEBHOOK_PASSWORD=
# Agent sync API key (SHA-256 hash of the actual key — never store the raw key)
AGENT_API_KEY_HASH=
